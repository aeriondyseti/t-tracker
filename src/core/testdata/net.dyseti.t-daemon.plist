<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>net.dyseti.t-daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/home/testuser/.local/bin/t-daemon</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/home/testuser/.local/share/t/logs/t-daemon.log</string>
    <key>StandardErrorPath</key>
    <string>/home/testuser/.local/share/t/logs/t-daemon.err</string>
</dict>
</plist>
